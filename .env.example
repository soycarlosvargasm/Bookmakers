NODE_ENV=development
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<database>
# For the existing Supabase project, set SUPABASE_DB_URL to the exact URI from
# Supabase Dashboard > Connect (Session pooler, with sslmode=require). Do not use
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY as a PostgreSQL password.
# SUPABASE_DB_URL takes precedence over DATABASE_URL and PG* variables when set.
# For Supabase use the pooler connection string from Connect with sslmode=require.
# Supabase schema is managed by `supabase db push`; set this to false for the API container.
RUN_APP_MIGRATIONS=true
API_KEY=<generate-a-long-random-local-key>
SESSION_STORAGE_PATH=.sessions
# Optional: attach BetOnline to an already-running authorized Chrome.
BETONLINE_CDP_URL=http://127.0.0.1:9223
POLLING_ENABLED=false
POSTGRES_USER=<user>
POSTGRES_PASSWORD=<password>
POSTGRES_DB=<database>
